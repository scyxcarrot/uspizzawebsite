# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Server-only Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Main chat model (needs function calling and streaming). See README for the chosen model.
GEMINI_MODEL=

# Used only when GEMINI_MODEL returns a rate-limit or quota error: that call is
# retried once on this model. Leave empty for no fallback.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Model used for the separate web_search request (needs Google Search grounding).
GEMINI_SEARCH_MODEL=

# Optional. Server-side cap on Gemini requests per day (default 300), so testing
# and reviewers can't use up the whole free-tier quota. Best-effort on serverless.
GEMINI_DAILY_REQUEST_CAP=300

# true = scripted chatbot replies for browser tests only. Refused when VERCEL_ENV=production.
AI_MOCK=false

# Neon Postgres for the menu and outlet settings (added by Vercel Storage; pull it
# with `vercel env pull`). Leave empty to use the original src/data files only.
DATABASE_URL=

# Password for /admin (at least 8 characters). Checked on the server only.
ADMIN_PASSWORD=
