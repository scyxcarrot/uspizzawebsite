# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Server-only Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Main chat model (needs function calling and streaming). See README for the chosen model.
GEMINI_MODEL=

# Model used for the separate web_search request (needs Google Search grounding).
GEMINI_SEARCH_MODEL=

# true = scripted chatbot replies for browser tests only. Refused when VERCEL_ENV=production.
AI_MOCK=false
